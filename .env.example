# Required: OpenRouter API key for LLM chat
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Massive API key for real market data (leave empty for simulator)
MASSIVE_API_KEY=

# Optional: Set to "true" for mock LLM responses (testing)
LLM_MOCK=false

# Optional: Massive polling interval in seconds
MASSIVE_POLL_INTERVAL=15
